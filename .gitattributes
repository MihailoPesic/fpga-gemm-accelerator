# Normalize line endings: LF in the repo, LF in the working tree.
# Vivado, XSim and the Xilinx toolchain all read LF fine on Windows.
* text=auto eol=lf

# Source
*.v      text
*.vh     text
*.sv     text
*.svh    text
*.vhd    text
*.vhdl   text
*.xdc    text
*.tcl    text
*.do     text
*.md     text
*.mem    text
*.coe    text

# IP configuration - machine-written XML; keep tracked for reproducibility.
*.xci    text
*.bd     text
*.prj    text

# Curated measurement artifacts and reports (excluded from GitHub language stats).
results/** linguist-generated=true
results/**/*.png binary
results/**/*.pdf binary
