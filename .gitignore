# ---------------------------------------------------------------------------
# Vivado / Vitis generated artifacts
#
# Patterns are depth-agnostic on purpose: they match both a project created at
# the repo root and one reconstructed under build/ by the project scripts.
#
# The original *.srcs/ and .xpr preserve the native-DDR baseline. New portable
# GEMM RTL lives in rtl/. New generated projects/IP belong under build/.
# ---------------------------------------------------------------------------

# The historical GUI project and its sources remain tracked. The native-DDR
# reconstruction script references those sources and imports IP into build/.
*.xpr.orig
*.ppr

# Generated project directories
*.cache/
*.hw/
*.sim/
*.runs/
*.gen/
*.ip_user_files/
*.sdk/
*.hls/
.Xil/
.vitis/
.jobs/

# Checkpoints, bitstreams, hardware handoff
*.dcp
*.bit
*.bin
*.ltx
*.mmi
*.mcs
*.prm
*.xsa
*.sysdef
*.hdf

# Simulation output
xsim.dir/
*.vvp
*.wdb
*.wcfg
*.vcd
*.saif
*.jou
*.str
*.pb
*.wpc
*.wdf
*.zip

# Logs, crash dumps, telemetry
*.log
*.rpt
hs_err_*
vivado_pid*
webtalk*.jou
webtalk*.log
webtalk*.html
webtalk*.wdm
usage_statistics_webtalk*
.crashReporter/
*.backup.jou
*.backup.log

# Curated JTAG records referenced by saved board-result manifests.
!results/ddr_gemm/board/program.log
!results/ddr_gemm/gather4/board/program.log
!results/ddr_gemm/maximum/program.log
!results/ddr_gemm/p8_serial/board/program.log
!results/ddr_gemm/read4/host_geometry/board/program.log

# Exact bounded-SAT transcripts and reachable witnesses.
!results/dma_rows/formal/*.log
!results/dma_rows/formal/*.vcd
!results/buffer_formal/*.vcd
!results/buffer_formal/linux/*.vcd
!results/dma_rows/formal/linux/*.vcd
!results/ddr_overlap/timing_predicate/final_build/routed/review/vivado.log
!results/ddr_overlap/timing_predicate/final_build/routed/review/vivado.jou

# Vitis / XSCT workspace
workspace/
_ide/
Debug/
Release/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# GEMM builds and local Python environments (source and evidence stay tracked).
/build/
/.venv/
__pycache__/
*.pyc
