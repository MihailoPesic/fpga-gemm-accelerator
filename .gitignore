# ---------------------------------------------------------------------------
# Vivado / Vitis generated artifacts
#
# Patterns are depth-agnostic on purpose: they match both a project created at
# the repo root and one created under vivado/ by scripts/create_project.tcl.
#
# NOTE: *.srcs/ is deliberately NOT ignored. If you ever add a file to the
# project with "Copy sources into project" left CHECKED, Vivado drops it into
# <project>.srcs/ and it would be silently lost. Leaving it visible means git
# reports it as untracked and you notice. Always add sources with copy OFF so
# they stay in src/ where they belong.
# ---------------------------------------------------------------------------

# Project file - regenerated by scripts/create_project.tcl
*.xpr
*.xpr.orig
*.ppr

# Generated project directories
*.cache/
*.hw/
*.sim/
*.runs/
*.gen/
*.ip_user_files/
*.sdk/
*.hls/
.Xil/
.vitis/
.jobs/

# Checkpoints, bitstreams, hardware handoff
*.dcp
*.bit
*.bin
*.ltx
*.mmi
*.mcs
*.prm
*.xsa
*.sysdef
*.hdf

# Simulation output
xsim.dir/
*.wdb
*.wcfg
*.vcd
*.saif
*.jou
*.str
*.pb
*.wpc
*.wdf
*.zip

# Logs, crash dumps, telemetry
*.log
*.rpt
hs_err_*
vivado_pid*
webtalk*.jou
webtalk*.log
webtalk*.html
webtalk*.wdm
usage_statistics_webtalk*
.crashReporter/
*.backup.jou
*.backup.log

# Vitis / XSCT workspace
workspace/
_ide/
Debug/
Release/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
